{
  "appId": "id.hendrayana.bacalayar",
  "productName": "Baca Layar",
  "executableName": "baca-layar",
  "asar": false,
  "directories": {
    "output": "dist-linux",
    "buildResources": "build"
  },
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "src/**/*",
    "renderer/**/*",
    "assets/**/*",
    "!test/**",
    "!vendor/**",
    "!build/**",
    "!dist/**",
    "!dist-linux/**",
    "!tessdata/**",
    "!scripts/**",
    "!node_modules/koffi/**",
    "!node_modules/@koromix/**",
    "!node_modules/tesseract.js/**",
    "!node_modules/tesseract.js-core/**",
    "!node_modules/@tesseract.js-data/**",
    "!**/*.{md,markdown,ts,map}",
    "!**/{test,tests,__tests__,example,examples,docs}/**"
  ],
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "build/icon.png",
    "category": "Utility",
    "synopsis": "Kumpulkan screenshot layar dengan gulir otomatis",
    "desktop": {
      "entry": {
        "Name": "Baca Layar",
        "Comment": "Kumpulkan screenshot layar (potret + gulir otomatis)"
      }
    }
  },
  "deb": {
    "depends": [
      "xdotool"
    ],
    "maintainer": "Hendrayana <hendrayana1234@users.noreply.github.com>"
  },
  "appImage": {
    "artifactName": "BacaLayar-${version}-linux-x64.AppImage"
  },
  "artifactName": "BacaLayar-${version}-linux-x64.${ext}",
  "compression": "maximum",
  "publish": null
}
